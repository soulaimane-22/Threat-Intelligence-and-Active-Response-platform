<!-- Custom Active Response commands -->


<command>
  <name>quarantine-file</name>
  <executable>quarantine-file.exe</executable>
  <timeout_allowed>no</timeout_allowed>
</command>


<!-- Wazuh to n8n integrations -->

<integration>
  <name>shuffle</name>
  <hook_url>http://n8n:5678/webhook/wazuh_alert</hook_url>
  <group>syscheck,active_response</group>
  <alert_format>json</alert_format>
</integration>

